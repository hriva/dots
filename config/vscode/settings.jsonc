{
  // VSCode
  "workbench.colorTheme": "Tokyo Night Light",
  "workbench.experimental.modernUI": false,
  "window.zoomLevel": 1,
  "github.copilot.chat.agent.thinkingTool": true,
  "github.copilot.chat.enableRetryAfterFilteredResponse": true,
  "github.copilot.chat.newWorkspace.useContext7": true,
  "chat.disableAIFeatures": true,
  "chat.editor.wordWrap": "on",
  "chat.commandCenter.enabled": false,

  // System
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "always",
  "git.fetchOnPull": true,
  "scm.diffDecorationsGutterWidth": 2,
  "search.useIgnoreFiles": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "breadcrumbs.enabled": false,
  "editor.fontFamily": "'GeistMono NFM'",
  "editor.fontSize": 15,
  "editor.lineHeight": 16,
  // "editor.fontWeight": 300,
  "editor.suggestFontSize": 16,
  "editor.suggestLineHeight": 30,
  "editor.wordWrap": "on",
  "editor.cursorStyle": "block",
  "editor.padding.top": 5,
  "editor.stickyScroll.enabled": true,
  "editor.cursorBlinking": "smooth",
  "editor.tabSize": 4,
  "editor.inlineSuggest.enabled": true,
  "editor.renderControlCharacters": false,
  "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'calt', 'dlig'",
  "editor.inlineSuggest.suppressSuggestions": true,
  "editor.snippetSuggestions": "top",
  "editor.detectIndentation": true,
  "editor.copyWithSyntaxHighlighting": false,
  "editor.emptySelectionClipboard": false,
  "editor.guides.indentation": true,
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.cursorSurroundingLines": 8,
  "editor.accessibilitySupport": "off",
  "editor.smoothScrolling": false,
  "workbench.list.smoothScrolling": false,
  "workbench.panel.defaultLocation": "right",
  "window.density.editorTabHeight": "compact",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.tabSizingFixedMinWidth": 38,
  "workbench.editor.enablePreview": false,
  "workbench.editor.closeOnFileDelete": true,
  "workbench.tree.enableStickyScroll": false,
  "workbench.browser.showInTitleBar": "whenOpen",
  "workbench.editorLargeFileConfirmation": 50,
  "workbench.navigationControl.enabled": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,
  "diffEditor.wordWrap": "on",
  // "workbench.editor.showTabs": "none",
  // "files.trimTrailingWhitespace": true,
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.activityBar.location": "top",
  "files.autoSave": "afterDelay",
  "files.exclude": {
    "**./.env": true,
    "**/__pycache__": true,
    "**/.cache": true,
    "**/.coverage": true,
    "**/.coverage.*": true,
    "**/.csv": true,
    "**/.hypothesis": true,
    "**/.mypy_cache": true,
    "**/.nox": true,
    "**/.parquet": true,
    "**/.pkl": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.tox": true,
    "**/.worktrees": true,
    "**/.xls": true
  },
  "files.watcherExclude": {
    "**/__pycache__": true,
    "**/.agents": true,
    "**/.claude": true,
    "**/.codex": true,
    "**/.context": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.ignore": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.worktrees/**": true,
    "**/node_modules/*/**": true,
    "**/pytest-of*": true
  },

  // python
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnType": true,
    "editor.formatOnSave": true,
    "diffEditor.ignoreTrimWhitespace": false
  },
  "autoDocstring.docstringFormat": "sphinx",
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.terminal.useEnvFile": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.fixAll": ["source.unusedImports"],
  "python.analysis.extraPaths": ["src", "lib", "resources"],
  "python.venvPath": "~/.local/share/python-venvs",
  "notebook.output.scrolling": true,
  "notebook.output.wordWrap": true,
  "jupyter.themeMatplotlibPlots": true,
  "jupyter.askForKernelRestart": true,
  "jupyter.widgetScriptSources": ["unpkg.com", "jsdelivr.com"],
  "jupyter.interactiveWindow.cellMarker.codeRegex": "^# COMMAND ----------|^# Databricks notebook source|^(#\\s*%%|#\\s*\\<codecell\\>|#\\s*In\\[\\d*?\\]|#\\s*In\\[ \\])",
  "jupyter.interactiveWindow.cellMarker.default": "# COMMAND ----------",

  // vscode-neovim
  "vscode-neovim.NVIM_APPNAME": "vscode-neovim",
  // To improve performance
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1,
    "asvetliakov.vscode-neovim": 1
  },

  // Terminal
  "terminal.integrated.lineHeight": 1.0,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.initialHint": false,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.env.linux": {
    "HISTFILE": "/home/alquimista/.vscode_history",
    "EDITRC": "/home/alquimista/.config/vscode-neovim/editrc"
  },

  // Per file settings
  "[plaintext]": {
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    },
    "editor.wordBasedSuggestions": "off",
    "editor.suggestOnTriggerCharacters": false
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  "bashIde.shfmt.path": "/home/alquimista/.local/share/nvim/mason/bin/shfmt",
  "[r]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Posit.air-vscode"
  },
  "[markdown]": {
    "editor.renderWhitespace": "all",
    "files.trimTrailingWhitespace": false
  },
  // SQL
  "sqltools.highlightQuery": false,
  "sqltools.format": {
    "linesBetweenQueries": 2
  },

  // Github Extension
  "githubPullRequests.pullBranch": "never",

  // Rest client
  "rest-client.previewColumn": "current",
  "makefile.configureOnOpen": true,

  // Remote Tunnels
  "remote.autoForwardPortsSource": "hybrid",
  "remote.portsAttributes": {
    "8000": {
      "protocol": "http"
    }
  },

  //  RH Yaml
  "redhat.telemetry.enabled": false,
  "extensions.allowOpenInModalEditor": true,

  // Openai
  "chatgpt.followUpQueueMode": "steer",

  // Claude Code
  "claudeCode.preferredLocation": "sidebar",
  "claudeCode.enableReopenClosedSessionShortcut": false,
  "claudeCode.allowDangerouslySkipPermissions": false,
  "claudeCode.claudeProcessWrapper": "~/.local/bin/claude-vscode-wrapper.sh",
  "containers.containerClient": "com.microsoft.visualstudio.containers.podman",
  "containers.orchestratorClient": "com.microsoft.visualstudio.orchestrators.podmancompose",
  "python.analysis.stubPath": "~/.local/share/nvim/lazy/python-type-stubs/stubs",
  "search.exclude": {
    "**/.worktrees/**": true,
    "**/pytest-of*": true
  },
  "git.blame.statusBarItem.template": "${authorName}:${hashShort} (${authorDateAgo})",
  "git.repositoryScanIgnoredFolders": ["node_modules", ".worktrees"],
  "scm.defaultViewMode": "tree",
  "scm.repositories.visible": 0,
  "git.worktreeSymlinkFolders": ["*.vscode", "*.context"],
  "git.branchProtection": ["dev", "main", "test"],
  "git.autofetchPeriod": 900,
  "debug.breakpointsView.presentation": "tree",
  "terminal.integrated.scrollback": 10000
  // "python.REPL.sendToNativeREPL": true,
  // "python.REPL.enableREPLSmartSend": true,
  // "terminal.integrated.ignoreBracketedPasteMode": true
}
