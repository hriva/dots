{
  // VSCode
  "workbench.colorTheme": "Tokyo Night Light",
  "workbench.experimental.modernUI": false,
  "window.zoomLevel": 1,
  "github.copilot.chat.agent.thinkingTool": true,
  "github.copilot.chat.enableRetryAfterFilteredResponse": true,
  "github.copilot.chat.newWorkspace.useContext7": true,
  "chat.disableAIFeatures": true,
  "chat.editor.wordWrap": "on",
  "chat.commandCenter.enabled": false,

  // System
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "always",
  "git.fetchOnPull": true,
  "scm.diffDecorationsGutterWidth": 2,
  "search.useIgnoreFiles": true,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "breadcrumbs.enabled": false,
  "editor.fontFamily": "'GeistMono NFM'",
  "editor.fontSize": 15,
  "editor.lineHeight": 16,
  // "editor.fontWeight": 300,
  "editor.suggestFontSize": 16,
  "editor.suggestLineHeight": 30,
  "editor.wordWrap": "on",
  "editor.cursorStyle": "block",
  "editor.padding.top": 5,
  "editor.stickyScroll.enabled": true,
  "editor.cursorBlinking": "smooth",
  "editor.tabSize": 4,
  "editor.inlineSuggest.enabled": true,
  "editor.renderControlCharacters": false,
  "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'calt', 'dlig'",
  "editor.inlineSuggest.suppressSuggestions": true,
  "editor.snippetSuggestions": "top",
  "editor.detectIndentation": true,
  "editor.copyWithSyntaxHighlighting": false,
  "editor.emptySelectionClipboard": false,
  "editor.guides.indentation": true,
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.cursorSurroundingLines": 8,
  "editor.accessibilitySupport": "off",
  "editor.smoothScrolling": false,
  "workbench.list.smoothScrolling": false,
  "workbench.panel.defaultLocation": "right",
  "window.density.editorTabHeight": "compact",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.tabSizingFixedMinWidth": 38,
  "workbench.editor.enablePreview": false,
  "workbench.editor.closeOnFileDelete": true,
  "workbench.tree.enableStickyScroll": false,
  "workbench.browser.showInTitleBar": "whenOpen",
  "workbench.editorLargeFileConfirmation": 50,
  "workbench.navigationControl.enabled": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,
  "diffEditor.wordWrap": "on",
  // "workbench.editor.showTabs": "none",
  // "files.trimTrailingWhitespace": true,
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.activityBar.location": "top",
  "files.autoSave": "afterDelay",
  "files.exclude": {
    "**./.env": true,
    "**/.csv": true,
    "**/.parquet": true,
    "**/.pkl": true,
    "**/.xls": true,
    "**/__pycache__": true,
    "**/.cache": true,
    "**/.coverage": true,
    "**/.coverage.*": true,
    "**/.hypothesis": true,
    "**/.mypy_cache": true,
    "**/.nox": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.tox": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.ignore": true,
    "**/.context": true,
    "**/.claude": true,
    "**/.codex": true,
    "**/.agents": true
  },

  // python
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnType": true,
    "editor.formatOnSave": true,
    "diffEditor.ignoreTrimWhitespace": false
  },
  "autoDocstring.docstringFormat": "sphinx",
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.fixAll": ["source.unusedImports"],
  "python.analysis.extraPaths": ["src", "lib", "resources"],
  "python.venvPath": "~/.local/share/python-venvs",
  "notebook.output.scrolling": true,
  "notebook.output.wordWrap": true,
  "jupyter.themeMatplotlibPlots": true,
  "jupyter.askForKernelRestart": true,
  "jupyter.widgetScriptSources": ["unpkg.com", "jsdelivr.com"],

  // vscode-neovim
  "vscode-neovim.NVIM_APPNAME": "vscode-neovim",
  // To improve performance
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1,
    "asvetliakov.vscode-neovim": 1
  },

  // VScode VIM
  "vim.enableNeovim": false,
  "vim.overrideCopy": false,
  "vim.leader": "<space>",
  "vim.hlsearch": true,
  "vim.useSystemClipboard": true,
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-s>": false,
    "<C-b>": false
    // "<C-p>": false
  },
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "k"],
      "after": ["<Esc>"]
    }
  ],
  "vim.normalModeKeyBindings": [
    {
      "before": ["<C-n>"],
      "commands": [":nohl"]
    },
    {
      "before": ["<C-h>"],
      "commands": ["workbench.action.navigateLeft"]
    },
    {
      "before": ["<C-j>"],
      "commands": ["workbench.action.navigateDown"]
    },
    {
      "before": ["<C-k>"],
      "commands": ["workbench.action.navigateUp"]
    },
    {
      "before": ["<C-l>"],
      "commands": ["workbench.action.navigateRight"]
    },
    {
      "before": ["<A-j>"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["<A-k>"],
      "commands": ["workbench.action.previousEditor"]
    },
    {
      "before": ["<leader>", "x"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    {
      "before": ["<leader>", "f", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["<leader>", "f", "o"],
      "commands": ["workbench.action.quickOpenWithModes"]
    },
    {
      "before": ["<leader>", "f", "r"],
      "commands": ["workbench.action.openRecent"]
    },
    {
      "before": ["<leader>", "d", "t"],
      "commands": ["workbench.files.action.compareFileWith"]
    },
    {
      "before": ["<leader>", "f", "R"],
      "commands": ["workbench.action.replaceInFiles"]
    },
    {
      "before": ["<leader>", "f", "w"],
      "commands": ["workbench.action.findInFiles"]
    },
    // LSP
    {
      "before": ["K"],
      "commands": ["editor.action.showDefinitionPreviewHover"]
    },
    {
      "before": ["g", "D"],
      "commands": ["editor.action.revealDefinitionAside"]
    },
    {
      "before": ["K"],
      "commands": ["editor.action.showDefinitionPreviewHover"]
    },
    {
      "before": ["g", "p", "d"],
      "commands": ["editor.action.peekDefinition"]
    },
    {
      "before": ["g", "h"],
      "commands": ["editor.action.showDefinitionPreviewHover"]
    },
    {
      "before": ["g", "i"],
      "commands": ["editor.action.goToImplementation"]
    },
    {
      "before": ["g", "p", "i"],
      "commands": ["editor.action.peekImplementation"]
    },
    {
      "before": ["g", "q"],
      "commands": ["editor.action.quickFix"]
    },
    {
      "before": ["g", "t"],
      "commands": ["editor.action.goToTypeDefinition"]
    },
    {
      "before": ["g", "p", "t"],
      "commands": ["editor.action.peekTypeDefinition"]
    },
    {
      "before": ["<leader>", "f", "s"],
      "commands": ["workbench.action.showAllSymbols"]
    },
    {
      "before": ["g", "r"],
      "commands": ["references-view.findReferences"]
    },
    {
      "before": ["g", "R"],
      "commands": ["editor.action.referenceSearch.trigger"]
    },
    {
      "before": ["<leader>", "s", "d"],
      "commands": ["workbench.actions.view.toggleProblems"]
    },

    // Git
    {
      "before": ["[", "c"],
      "commands": ["workbench.action.editor.previousChange"]
    },
    {
      "before": ["]", "c"],
      "commands": ["workbench.action.editor.nextChange"]
    },
    {
      "before": ["]", "d"],
      "commands": ["editor.action.marker.nextInFiles"]
    },
    {
      "before": ["[", "d"],
      "commands": ["editor.action.marker.prevInFiles"]
    },
    {
      "before": ["<leader>", "g", "d"],
      "commands": ["git.openChange"]
    },
    {
      "before": ["<leader>", "g", "r"],
      "commands": ["git.revertSelectedRanges"]
    },
    {
      "before": ["<leader>", "g", "s"],
      "commands": ["git.stageSelectedRanges"]
    },
    {
      "before": ["<leader>", "g", "u"],
      "commands": ["git.unstageSelectedRanges"]
    },
    {
      "before": ["u"],
      "commands": ["undo"]
    },
    {
      "before": ["<C-r>"],
      "commands": ["redo"]
    },
    {
      "before": ["<C-]>"],
      "commands": ["workbench.action.decreaseViewSize"]
    },
    {
      "before": ["<C-[>"],
      "commands": ["workbench.action.increaseViewSize"]
    },
    {
      "before": ["<leader>", "/"],
      "commands": ["editor.action.commentLine"]
    } //,
    // // Windsurf exclusive
    // {
    //     "before": [
    //         "<leader>",
    //         "k"
    //     ],
    //     "commands": [
    //         "deepwiki.openSymbol",
    //     ]
    // },
    // // Codex exclusive
    // {
    //     "before": [
    //         "<leader>",
    //         "a",
    //         "a"
    //     ],
    //     "commands": [
    //         "chatgpt.addToThread",
    //     ]
    // }
  ],
  "vim.visualModeKeyBindings": [
    {
      "before": [">"],
      "commands": ["editor.action.indentLines"]
    },
    {
      "before": ["<"],
      "commands": ["editor.action.outdentLines"]
    },
    {
      "before": ["<leader>", "g", "r"],
      "commands": ["git.revertSelectedRanges"]
    },
    {
      "before": ["<leader>", "g", "s"],
      "commands": ["git.stageSelectedRanges"]
    },
    {
      "before": ["<leader>", "g", "u"],
      "commands": ["git.unstageSelectedRanges"]
    },
    {
      "before": ["<leader>", "/"],
      "commands": ["editor.action.commentLine"]
    }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    // paste w/o register override
    {
      "before": ["p"],
      "after": ["p", "g", "v", "y"]
    }
  ],
  "vim.insertModeKeyBindingsNonRecursive": [],

  // Terminal
  "terminal.integrated.lineHeight": 1.0,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.initialHint": false,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.env.linux": {
    "HISTFILE": "/home/alquimista/.vscode_history"
  },

  // Per file settings
  "[plaintext]": {
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    },
    "editor.wordBasedSuggestions": "off",
    "editor.suggestOnTriggerCharacters": false
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  "bashIde.shfmt.path": "/home/alquimista/.local/share/nvim/mason/bin/shfmt",
  "[r]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Posit.air-vscode"
  },
  "[markdown]": {
    "editor.renderWhitespace": "all",
    "files.trimTrailingWhitespace": false
  },
  // SQL
  "sqltools.highlightQuery": false,
  "sqltools.format": {
    "linesBetweenQueries": 2
  },

  // Github Extension
  "githubPullRequests.pullBranch": "never",

  // Rest client
  "rest-client.previewColumn": "current",
  "makefile.configureOnOpen": true,

  // Remote Tunnels
  "remote.autoForwardPortsSource": "hybrid",
  "remote.portsAttributes": {
    "8000": {
      "protocol": "http"
    }
  },

  //  RH Yaml
  "redhat.telemetry.enabled": false,
  "extensions.allowOpenInModalEditor": true,

  // Openai
  "chatgpt.followUppQueueMode": "steer",

  // Claude Code
  "claudeCode.preferredLocation": "sidebar",
  "claudeCode.enableReopenClosedSessionShortcut": false,
  "claudeCode.allowDangerouslySkipPermissions": false,
  "claudeCode.claudeProcessWrapper": "~/.local/bin/claude-vscode-wrapper.sh"
}
